{
  "name": "paw-pure",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "node --experimental-strip-types --test tests/*.test.mjs && vitest run tests/app-select.test.ts tests/app-date-picker.test.ts tests/app-time-picker.test.ts tests/entry-page.test.ts tests/photos.test.ts tests/store-setup-panel.test.ts tests/payment-modal.test.ts",
    "test:e2e": "playwright test",
    "test:e2e:real": "playwright test -c playwright.real.config.ts",
    "test:e2e:mysql": "playwright test -c playwright.mysql.config.ts"
  },
  "dependencies": {
    "echarts": "^5.5.0",
    "lucide-vue-next": "^0.468.0",
    "pinia": "^2.2.0",
    "vue": "^3.5.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.50.1",
    "@vitejs/plugin-vue": "^5.2.0",
    "@vue/test-utils": "^2.4.6",
    "autoprefixer": "^10.4.0",
    "jsdom": "^25.0.1",
    "postcss": "^8.4.0",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.7.0",
    "vite": "^5.4.0",
    "vitest": "^2.1.9",
    "vue-tsc": "^2.2.0"
  }
}
